# ---------------------------------------------------------------- database
DATABASE_URL=postgresql://user:password@localhost:5432/agency_crm

# ------------------------------------------------------------------- app
# Used for absolute deep links in Telegram notifications.
APP_URL=http://localhost:3000
# 32+ random bytes, base64. Signs session cookies. `openssl rand -base64 32`
SESSION_SECRET=

# ------------------------------------------------------------------ upwork
# Leave USE_MOCK_UPWORK=true to run the whole app with fixture data and no
# real credentials. Set it to false only once the four accounts are connected.
USE_MOCK_UPWORK=true
UPWORK_CLIENT_ID=
UPWORK_CLIENT_SECRET=
UPWORK_REDIRECT_URI=http://localhost:3000/api/upwork/callback
# Shared secret used to verify inbound Upwork webhook signatures.
UPWORK_WEBHOOK_SECRET=

# -------------------------------------------------------------------- cron
# Bearer token required by /api/cron/sync. Railway cron sends it.
CRON_SECRET=

# ---------------------------------------------------------------- telegram
TELEGRAM_BOT_TOKEN=your-bot-token-from-botfather
TELEGRAM_CHAT_ID=
# Verifies that inbound Telegram webhook calls really came from Telegram.
# Any random 32-character alphanumeric string.
TELEGRAM_WEBHOOK_SECRET=generate-a-random-32-char-alphanumeric-string
# Default false: messages print to the server console and are logged to the
# notifications table instead of being delivered. Set true to send for real.
TELEGRAM_ENABLED=false
# Shown on the settings page so people know which bot to open.
TELEGRAM_BOT_USERNAME=your_bot_username_without_the_at
# The team group. Unowned alerts, the four-hourly nudges, contract and handover
# announcements and the shift-start summary post here. Group ids are NEGATIVE —
# a value without the minus sign addresses a private chat that does not exist
# and every group message fails as "chat not found". Leave blank for no group.
TELEGRAM_GROUP_CHAT_ID=
# Only needed on networks that block Telegram over IPv4.
TELEGRAM_FORCE_IPV6=false
